# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Bark Configuration
# Get this from the Bark App on your iOS device
BARK_DEVICE_KEY=your-bark-key-here


# GLaDOS Check-in Configuration
# Get your Cookie from browser developer tools on glados.rocks
GLADOS_COOKIE=your-glados-cookie-here
# Optional: Custom API URL (defaults to https://glados.rocks/api/user/checkin)
GLADOS_API_URL=https://glados.rocks/api/user/checkin

# Cron & Access Configuration
# Vercel Cron protection secret (automatic in Vercel)
CRON_SECRET=your-cron-secret-here
# Custom key for dashboard operations (save this in your browser)
APP_KEY=your-app-secret-here
