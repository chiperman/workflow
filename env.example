# Workflow Operations - Environment Variables Example

# 1. Host Supabase Configuration (Required)
# 这个项目是“宿主”，用于存储所有任务的配置和运行历史。
NEXT_PUBLIC_SUPABASE_URL=https://your-host-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Access & Security (Required)
# APP_KEY: 用于管理后台的登录验证密码。
# CRON_SECRET: 保护 /api/cron-all 接口，触发请求需带 Authorization: Bearer <SECRET>。
APP_KEY=your-admin-password-here
CRON_SECRET=your-secure-cron-secret-here

# 3. Global Notification Fallback (Optional)
# 如果任务配置中没有填独立的 Bark Key，系统会默认推送到这里。
BARK_DEVICE_KEY=your-default-bark-key-here

# 4. Debugging (Optional)
# LOG_LEVEL: debug | info | warn | error | silent (默认: info)
LOG_LEVEL=info
