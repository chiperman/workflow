# ==============================================================================
# Workflow Operations - Environment Variables Example
# Copy this file to .env.local and fill in your values.
# ==============================================================================

# 1. Supabase Configuration (Required)
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Access & Security (Required)
# APP_KEY: Your private key to access the dashboard (e.g., a long random string).
# CRON_SECRET: Used by Vercel to authorize cron jobs (set this in Vercel project settings).
APP_KEY=your-custom-access-key-here
CRON_SECRET=your-cron-auth-secret-here

# 3. Service Configurations (Optional/Service-Specific)

# GLaDOS: Get your Cookie from browser developer tools while logged into glados.rocks
GLADOS_COOKIE=your-glados-cookie-here
# Optional: GLADOS_API_URL=https://glados.rocks/api/user/checkin

# Bark: iOS push notification key from the Bark app.
BARK_DEVICE_KEY=your-bark-device-key-here

# 4. Debugging (Optional)
# LOG_LEVEL: debug | info | warn | error | silent (Default: info in dev, warn in prod)
# LOG_LEVEL=info
